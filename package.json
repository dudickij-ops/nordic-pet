{
  "name": "nordic-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:reset": "node scripts/db-reset.ts",
    "ingest:sheets": "node --env-file-if-exists=.env.local scripts/ingest-sheets.ts",
    "ingest:ads": "node --env-file-if-exists=.env.local scripts/ingest-ads.ts",
    "facts": "node --env-file-if-exists=.env.local scripts/build-facts.ts",
    "metrics": "node --env-file-if-exists=.env.local scripts/print-metrics.ts",
    "breaks": "node scripts/run-breaks.ts",
    "test:live": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts"
  },
  "dependencies": {
    "google-auth-library": "^11.0.2",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "pg": "^8.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
